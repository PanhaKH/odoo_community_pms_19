<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_sql_business_report" model="report.paperformat">
        <field name="name">SQL Business Report A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">4</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sql_business" model="ir.actions.report">
        <field name="name">SQL Business Report</field>
        <field name="model">psql.query</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">psql_query_execute.report_sql_business_document</field>
        <field name="report_file">psql_query_execute.report_sql_business_document</field>
        <field name="paperformat_id" ref="paperformat_sql_business_report"/>
        <field name="print_report_name">(object.name or 'Business Report').replace('/', '_')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sql_business_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="env.company"/>
                <t t-set="printed_at" t-value="context_timestamp(datetime.datetime.now())"/>
                <t t-set="presentation" t-value="doc._get_report_presentation()"/>
                <t t-set="columns" t-value="presentation.get('columns', [])"/>
                <t t-set="data_report_landscape" t-value="presentation.get('landscape')"/>

                <div class="footer qsql-page-footer">
                    <table>
                        <tr>
                            <td>Generated by qSQL Report Engine</td>
                            <td class="qsql-text-center">
                                <t t-if="report_type == 'pdf'">Page <span class="page"/> of <span class="topage"/></t>
                            </td>
                            <td class="qsql-text-right">
                                Printed on: <span t-esc="printed_at.strftime('%Y-%m-%d %H:%M')"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <div class="article" t-att-data-oe-model="doc._name"
                     t-att-data-oe-id="doc.id" t-att-data-oe-lang="doc.env.context.get('lang')">
                    <div class="page qsql-hotel-report-page">
                        <style>
                            .qsql-hotel-report-page {
                                font-family: Arial, 'Odoo Unicode Support Noto', 'Khmer OS Battambang', sans-serif;
                                color: #222222;
                                font-size: 10px;
                            }
                            .qsql-page-footer {
                                color: #666666;
                                font-family: Arial, sans-serif;
                                font-size: 8.5px;
                                border-top: 1px solid #cccccc;
                                padding-top: 4px;
                            }
                            .qsql-page-footer table,
                            .qsql-report-list,
                            .qsql-brand-table,
                            .qsql-filter-table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .qsql-page-footer td { width: 33.33%; }
                            .qsql-text-center { text-align: center; }
                            .qsql-text-right { text-align: right; }
                            .qsql-report-list {
                                table-layout: fixed;
                                font-size: 10px;
                            }
                            .qsql-density-normal { font-size: 9.5px; }
                            .qsql-density-compact { font-size: 8px; }
                            .qsql-density-dense { font-size: 6.5px; }
                            .qsql-density-ultra { font-size: 5.5px; }
                            .qsql-report-list thead {
                                display: table-header-group;
                                background: #ffffff;
                            }
                            .qsql-report-list tfoot { display: table-row-group; }
                            .qsql-report-header-row th,
                            .qsql-filter-summary-row th {
                                padding: 0;
                                border: 0;
                                background: #ffffff;
                                white-space: normal;
                            }
                            .qsql-report-header {
                                width: 100%;
                                box-sizing: border-box;
                                padding: 7px 9px 6px;
                                overflow: hidden;
                                background: #ffffff;
                                border-bottom: 1px solid #d7dde5;
                            }
                            .qsql-header-layout {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                            }
                            .qsql-header-layout td {
                                padding: 0 8px;
                                vertical-align: middle;
                                white-space: normal;
                                overflow-wrap: anywhere;
                            }
                            .qsql-header-layout td:first-child { padding-left: 0; }
                            .qsql-header-layout td:last-child { padding-right: 0; }
                            .qsql-header-left { width: 30%; }
                            .qsql-header-center {
                                width: 40%;
                                border-left: 1px solid #d7dde5;
                                border-right: 1px solid #d7dde5;
                                text-align: center;
                            }
                            .qsql-header-right { width: 30%; text-align: right; }
                            .qsql-company-layout {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .qsql-company-layout td {
                                width: auto;
                                padding: 0 6px 0 0;
                                border: 0;
                                vertical-align: middle;
                            }
                            .qsql-company-layout .qsql-logo-cell { width: 1%; }
                            .qsql-company-logo {
                                display: block;
                                width: auto;
                                max-width: 76px;
                                height: auto;
                                max-height: 40px;
                                object-fit: contain;
                            }
                            .qsql-company-name {
                                margin: 0;
                                color: #082b52;
                                font-size: 13px;
                                font-weight: bold;
                                line-height: 15px;
                            }
                            .qsql-meta {
                                margin-top: 1px;
                                color: #666666;
                                font-size: 8px;
                                font-weight: normal;
                                line-height: 10px;
                            }
                            .qsql-report-title {
                                margin: 0;
                                color: #9b7a32;
                                font-size: 17px;
                                font-weight: bold;
                                line-height: 20px;
                                text-align: center;
                                overflow-wrap: anywhere;
                            }
                            .qsql-report-description {
                                margin: 2px 0 0;
                                color: #666666;
                                font-size: 8px;
                                font-weight: normal;
                                line-height: 10px;
                                text-align: center;
                            }
                            .qsql-filter-summary {
                                margin: 0;
                                padding: 3px 7px;
                                color: #555555;
                                background: #f7f7f7;
                                border-left: 3px solid #9b7a32;
                                border-bottom: 1px solid #e5e7eb;
                                font-size: 8px;
                                line-height: 10px;
                                font-weight: normal;
                                text-align: left;
                            }
                            .qsql-column-row {
                                border-top: 1px solid #555555;
                                border-bottom: 1px solid #555555;
                                background: #f2ead7;
                            }
                            .qsql-column-row th {
                                padding: 4px 5px;
                                color: #000000;
                                font-weight: bold;
                                line-height: 11px;
                                text-align: left;
                                white-space: nowrap;
                                overflow: hidden;
                                text-overflow: ellipsis;
                            }
                            .qsql-data-row { page-break-inside: avoid; }
                            .qsql-data-row td {
                                padding: 4px 5px;
                                border-bottom: 1px solid #dddddd;
                                line-height: 12px;
                                vertical-align: middle;
                                overflow: hidden;
                                overflow-wrap: break-word;
                                word-break: normal;
                            }
                            .qsql-type-date,
                            .qsql-type-datetime,
                            .qsql-type-integer,
                            .qsql-type-decimal,
                            .qsql-density-compact .qsql-data-row td,
                            .qsql-density-dense .qsql-data-row td,
                            .qsql-density-ultra .qsql-data-row td {
                                white-space: nowrap;
                                text-overflow: ellipsis;
                            }
                            .qsql-align-left { text-align: left; }
                            .qsql-align-center { text-align: center; }
                            .qsql-align-right { text-align: right; }
                            .qsql-density-compact .qsql-column-row th {
                                padding: 3px 4px;
                                line-height: 10px;
                            }
                            .qsql-density-compact .qsql-data-row td {
                                padding: 3px 4px;
                                line-height: 10px;
                            }
                            .qsql-density-dense .qsql-column-row th,
                            .qsql-density-ultra .qsql-column-row th {
                                padding: 2px 3px;
                                line-height: 8px;
                            }
                            .qsql-density-dense .qsql-data-row td,
                            .qsql-density-ultra .qsql-data-row td {
                                padding: 2px 3px;
                                line-height: 8px;
                            }
                            .qsql-large-dataset .qsql-data-row {
                                page-break-inside: auto;
                            }
                            .qsql-null { color: #888888; font-style: italic; }
                            .qsql-group-row td {
                                padding: 5px 6px;
                                color: #8a6a27;
                                background: #f7f3e9;
                                border-bottom: 1px solid #ddd5c2;
                                font-weight: bold;
                                page-break-after: avoid;
                            }
                            .qsql-total-row td {
                                padding: 6px;
                                background: #f2ead7;
                                border-top: 1px solid #555555;
                                font-weight: bold;
                            }
                            .qsql-empty {
                                padding: 12px;
                                border-top: 1px solid #555555;
                                border-bottom: 1px solid #dddddd;
                                color: #555555;
                                text-align: center;
                            }
                            .qsql-end-report {
                                margin-top: 12px;
                                color: #666666;
                                font-size: 9px;
                            }
                            @media screen {
                                .qsql-report-scroll {
                                    width: 100%;
                                    max-height: calc(100vh - 24px);
                                    overflow: auto;
                                    background: #ffffff;
                                    scrollbar-gutter: stable;
                                }
                                .qsql-report-list {
                                    min-width: var(--qsql-screen-min-width);
                                }
                                .qsql-report-header {
                                    position: sticky;
                                    left: 0;
                                    width: calc(100vw - 32px);
                                    max-width: 100%;
                                }
                                .qsql-sticky-report-head {
                                    position: sticky;
                                    top: 0;
                                    z-index: 20;
                                    background: #ffffff;
                                    box-shadow: 0 3px 8px rgba(8, 43, 82, 0.10);
                                }
                            }
                            @media screen and (max-width: 760px) {
                                .qsql-report-header { padding: 6px; }
                                .qsql-header-layout td { padding: 0 5px; }
                                .qsql-header-left { width: 32%; }
                                .qsql-header-center { width: 38%; }
                                .qsql-header-right { width: 30%; }
                                .qsql-company-logo { max-width: 52px; max-height: 32px; }
                                .qsql-company-name { font-size: 11px; line-height: 13px; }
                                .qsql-report-title { font-size: 14px; line-height: 16px; }
                                .qsql-meta,
                                .qsql-report-description,
                                .qsql-filter-summary { font-size: 7px; line-height: 9px; }
                            }
                            @media print {
                                .qsql-report-scroll {
                                    max-height: none !important;
                                    overflow: visible !important;
                                }
                                .qsql-report-list { min-width: 0 !important; }
                                .qsql-sticky-report-head {
                                    position: static !important;
                                    box-shadow: none !important;
                                }
                            }
                        </style>

                        <div t-if="columns" class="qsql-report-scroll">
                            <table t-att-class="'qsql-report-list qsql-density-%s%s' % (presentation.get('density', 'normal'), ' qsql-large-dataset' if presentation.get('large_dataset') else '')"
                                   t-att-style="'--qsql-screen-min-width: %spx;' % presentation.get('screen_min_width', 960)">
                            <colgroup>
                                <col t-foreach="columns" t-as="column"
                                     t-att-style="'width: %.3f%%%%;' % column.get('width_percent', (100.0 / len(columns)))"/>
                            </colgroup>
                            <thead class="qsql-sticky-report-head">
                                <tr class="qsql-report-header-row">
                                    <th t-att-colspan="len(columns)">
                                        <div class="qsql-report-header">
                                        <table class="qsql-header-layout">
                                            <tr>
                                                <td class="qsql-header-left">
                                                    <table class="qsql-company-layout">
                                                        <tr>
                                                            <td t-if="company.logo" class="qsql-logo-cell">
                                                                <img class="qsql-company-logo"
                                                                     t-att-src="image_data_uri(company.logo)"
                                                                     alt="Company logo"/>
                                                            </td>
                                                            <td>
                                                                <div class="qsql-company-name" t-esc="company.display_name"/>
                                                                <div class="qsql-meta">SQL Management Report</div>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td class="qsql-header-center">
                                                    <div class="qsql-report-title" t-esc="doc.name or 'SQL Report'"/>
                                                    <div t-if="doc.description" class="qsql-report-description" t-esc="doc.description"/>
                                                    <div class="qsql-meta">
                                                        <span t-esc="doc.category_id.complete_name or 'Uncategorized'"/>
                                                    </div>
                                                </td>
                                                <td class="qsql-header-right">
                                                    <div class="qsql-meta">Printed by: <span t-esc="env.user.display_name"/></div>
                                                    <div class="qsql-meta">Printed date: <span t-esc="printed_at.strftime('%Y-%m-%d %H:%M')"/></div>
                                                    <div class="qsql-meta">Company: <span t-esc="company.display_name"/></div>
                                                    <div t-if="doc.report_date_from or doc.report_date_to" class="qsql-meta">
                                                        Date range:
                                                        <span t-esc="doc.report_date_from or '...'"/> -
                                                        <span t-esc="doc.report_date_to or '...'"/>
                                                    </div>
                                                </td>
                                            </tr>
                                        </table>
                                        </div>
                                    </th>
                                </tr>
                                <tr t-if="doc.last_filter_summary or doc.report_filter_summary" class="qsql-filter-summary-row">
                                    <th t-att-colspan="len(columns)">
                                        <div class="qsql-filter-summary">
                                            <strong>Applied Filters:</strong>
                                            <span t-esc="doc.last_filter_summary or doc.report_filter_summary"/>
                                        </div>
                                    </th>
                                </tr>
                                <tr class="qsql-column-row">
                                    <th t-foreach="columns" t-as="column"
                                        t-att-style="'text-align: %s;' % ('right' if column['display_type'] in ('integer', 'decimal') else ('center' if column['display_type'] in ('date', 'datetime') else 'left'))"
                                        t-att-title="column['label']"
                                        t-esc="column['label']"/>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="presentation['groups']" t-as="group">
                                    <tr t-if="group['label'] is not False" class="qsql-group-row">
                                        <td t-att-colspan="len(columns)" t-esc="group['label']"/>
                                    </tr>
                                    <tr t-foreach="group['rows']" t-as="row" class="qsql-data-row">
                                        <td t-foreach="row" t-as="cell"
                                            t-att-class="'qsql-type-%s qsql-align-%s%s' % (cell.get('display_type', 'auto'), cell['alignment'], ' qsql-null' if cell['raw'] is None else '')"
                                            t-esc="cell['value']"/>
                                    </tr>
                                </t>
                                <tr t-if="not presentation['row_count']">
                                    <td t-att-colspan="len(columns)" class="qsql-empty">
                                        No records matched the selected period or filters. Review the criteria and run the report again.
                                    </td>
                                </tr>
                                <tr t-if="presentation['has_total']" class="qsql-total-row">
                                    <td t-foreach="presentation['totals']" t-as="cell"
                                        t-att-style="'text-align: %s;' % cell['alignment']"
                                        t-esc="cell['value']"/>
                                </tr>
                            </tbody>
                            </table>
                        </div>

                        <div t-if="not columns" class="qsql-empty">
                            No visible report columns are configured. Run the query, then enable at least one column under Report Column Presentation.
                        </div>

                        <div class="qsql-end-report">
                            End of Report &#8212; <span t-esc="presentation['row_count']"/> record(s)
                            <span t-if="doc.result_limited"> &#8212; Result limited to the configured maximum.</span>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
