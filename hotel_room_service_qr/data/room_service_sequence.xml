<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_hotel_room_service_order" model="ir.sequence">
        <field name="name">Room Service Order</field>
        <field name="code">hotel.room.service.order</field>
        <field name="prefix">RSO/%(y)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_cleanup_room_service_logs" model="ir.cron">
        <field name="name">Room Service: Clean Up Integration Logs</field>
        <field name="model_id" ref="hotel_room_service_qr.model_hotel_room_service_integration_log"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_integration_logs(30)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <function model="hotel.room.service.room.token" name="action_generate_missing_room_tokens"/>
</odoo>
