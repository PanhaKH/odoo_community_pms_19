<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_document_print_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.document.print.wizard.form</field>
        <field name="model">hotel.reservation.document.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Documents">
                <sheet>
                    <field name="reservation_id" invisible="1"/>
                    <group>
                        <button name="action_print_reservation_confirmation" string="Reservation Confirmation" type="object" class="btn-secondary" icon="fa-print"/>
                        <button name="action_print_registration_card" string="Registration Card" type="object" class="btn-secondary" icon="fa-id-card-o"/>
                        <button name="action_print_tax_invoice" string="Tax Invoice" type="object" class="btn-secondary" icon="fa-file-text-o"/>
                        <button name="action_print_commercial_invoice" string="Commercial Invoice" type="object" class="btn-secondary" icon="fa-file-text-o"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
