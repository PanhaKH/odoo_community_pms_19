<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_registration_card_sign_print_wizard_form" model="ir.ui.view">
        <field name="name">hotel.registration.card.sign.print.wizard.form</field>
        <field name="model">hotel.registration.card.sign.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Registration Card">
                <sheet>
                    <field name="reservation_id" invisible="1"/>
                    <div class="alert alert-info" role="status">
                        Add your Staff E-Signature before printing?
                    </div>
                </sheet>
                <footer>
                    <button name="action_sign_and_print" string="Yes, Sign &amp; Print" type="object" class="btn-primary"/>
                    <button name="action_print_without_signature" string="No, Print Without Staff Signature" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
