<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hotel_management.DashboardTemplate" owl="1">
        <div class="o_hotel_dashboard p-4" style="background-color: #f0f2f5; height: 100vh; overflow-y: auto;">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary font-weight-bold">Front Desk Dashboard</h2>
                <button class="btn btn-secondary btn-sm" t-on-click="loadStats">
                    <i class="fa fa-refresh"/> Refresh
                </button>
            </div>

            <div class="row">
                
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-primary h-100 shadow-sm" 
                         style="cursor: pointer; transition: transform 0.2s;"
                         t-on-click="() => this.viewRooms('all')"> <div class="card-body text-center">
                            <h5 class="card-title text-uppercase font-weight-bold" style="font-size: 0.9rem; opacity: 0.9;">Total Rooms</h5>
                            <h2 class="display-4 font-weight-bold"><t t-esc="state.stats.total"/></h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-success h-100 shadow-sm" 
                         style="cursor: pointer; transition: transform 0.2s;"
                         t-on-click="() => this.viewRooms('available')"> <div class="card-body text-center">
                            <h5 class="card-title text-uppercase font-weight-bold" style="font-size: 0.9rem; opacity: 0.9;">Available</h5>
                            <h2 class="display-4 font-weight-bold"><t t-esc="state.stats.available"/></h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-info h-100 shadow-sm" 
                         style="cursor: pointer; transition: transform 0.2s;"
                         t-on-click="() => this.viewRooms('occupied')"> <div class="card-body text-center">
                            <h5 class="card-title text-uppercase font-weight-bold" style="font-size: 0.9rem; opacity: 0.9;">Occupied</h5>
                            <h2 class="display-4 font-weight-bold"><t t-esc="state.stats.occupied"/></h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-warning h-100 shadow-sm" 
                         style="cursor: pointer; transition: transform 0.2s;"
                         t-on-click="() => this.viewRooms('dirty')"> <div class="card-body text-center">
                            <h5 class="card-title text-uppercase font-weight-bold" style="font-size: 0.9rem; opacity: 0.9;">Dirty Rooms</h5>
                            <h2 class="display-4 font-weight-bold text-white"><t t-esc="state.stats.dirty"/></h2>
                        </div>
                    </div>
                </div>

            </div>
            
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white font-weight-bold">Quick Actions</div>
                        <div class="card-body">
                           <p class="text-muted">Select a card above to view detailed room lists.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>