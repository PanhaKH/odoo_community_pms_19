<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Guest Reservation Sequence -->
        <record id="seq_hotel_reservation" model="ir.sequence">
            <field name="name">Hotel Reservation</field>
            <field name="code">hotel.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 🔥 NEW: Block Sequence -->
        <record id="seq_hotel_reservation_block" model="ir.sequence">
            <field name="name">Hotel Reservation Block</field>
            <field name="code">hotel.reservation.block</field>
            <field name="prefix">BLK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Housekeeping -->
        <record id="seq_hotel_housekeeping" model="ir.sequence">
            <field name="name">Housekeeping Task</field>
            <field name="code">hotel.housekeeping</field>
            <field name="prefix">HK/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>