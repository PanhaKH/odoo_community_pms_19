<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <record model="ir.module.category" id="module_category_hotel">
            <field name="name">Hotel</field>
            <field name="description">Hotel Management Access Levels</field>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_hotel">
            <field name="name">Hotel</field>
            <field name="category_id" ref="module_category_hotel"/>
        </record>

        <record id="group_hotel_housekeeping" model="res.groups">
            <field name="name">Z-Legacy Housekeeping</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
        </record>
        <record id="group_hotel_front_desk" model="res.groups">
            <field name="name">Z-Legacy Front Desk</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
        </record>


        <record id="group_hotel_housekeeper" model="res.groups">
            <field name="name">Housekeeper</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hotel_front_office" model="res.groups">
            <field name="name">Front office</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hotel_night_auditor" model="res.groups">
            <field name="name">Night Auditor</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
        </record>

        <record id="group_hotel_front_office_manager" model="res.groups">
            <field name="name">Front office Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('hotel_management.group_hotel_front_office')), (4, ref('hotel_management.group_hotel_night_auditor'))]"/>
        </record>

        <record id="group_hotel_account_receivable" model="res.groups">
            <field name="name">Account Receivable</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hotel_manager" model="res.groups">
            <field name="name">Hotel Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('hotel_management.group_hotel_front_office_manager')), (4, ref('hotel_management.group_hotel_housekeeper')), (4, ref('hotel_management.group_hotel_account_receivable'))]"/>
        </record>

        <record id="group_hotel_system_admin" model="res.groups">
            <field name="name">System Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_hotel"/>
            <field name="implied_ids" eval="[(4, ref('hotel_management.group_hotel_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="hotel_feature_lost_found_read" model="res.groups">
            <field name="name">Lost &amp; Found Read</field>
        </record>

        <record id="hotel_feature_lost_found_create" model="res.groups">
            <field name="name">Lost &amp; Found Create</field>
        </record>

        <record id="hotel_feature_lost_found_write" model="res.groups">
            <field name="name">Lost &amp; Found Edit</field>
        </record>

        <record id="hotel_feature_lost_found_delete" model="res.groups">
            <field name="name">Lost &amp; Found Delete</field>
        </record>

        <record id="hotel_feature_guest_request_read" model="res.groups">
            <field name="name">Guest Requests Read</field>
        </record>

        <record id="hotel_feature_guest_request_submit" model="res.groups">
            <field name="name">Guest Requests Submit</field>
        </record>

        <record id="hotel_feature_guest_request_create" model="res.groups">
            <field name="name">Guest Requests Create</field>
        </record>

        <record id="hotel_feature_guest_request_write" model="res.groups">
            <field name="name">Guest Requests Edit</field>
        </record>

        <record id="hotel_feature_guest_request_delete" model="res.groups">
            <field name="name">Guest Requests Delete</field>
        </record>

        <record id="rule_hotel_reservation_portal_own" model="ir.rule">
            <field name="name">Portal Reservations: Own Only</field>
            <field name="model_id" ref="hotel_management.model_hotel_reservation"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_service_request_portal_own" model="ir.rule">
            <field name="name">Portal Service Requests: Own Only</field>
            <field name="model_id" ref="hotel_management.model_hotel_service_request"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('reservation_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_reservation_housekeeper_read_all" model="ir.rule">
            <field name="name">Housekeepers: Read Reservations</field>
            <field name="model_id" ref="hotel_management.model_hotel_reservation"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_housekeeper'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_reservation_front_office_all" model="ir.rule">
            <field name="name">Front Office: Manage Reservations</field>
            <field name="model_id" ref="hotel_management.model_hotel_reservation"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_folio_sale_order_front_office" model="ir.rule">
            <field name="name">Front Office: Hotel Folio Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">['|', ('hotel_reservation_ids', '!=', False), ('hotel_group_master_ids', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_folio_sale_order_line_front_office" model="ir.rule">
            <field name="name">Front Office: Hotel Folio Lines Only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">['|', ('order_id.hotel_reservation_ids', '!=', False), ('order_id.hotel_group_master_ids', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_folio_sale_order_front_office_manager" model="ir.rule">
            <field name="name">Front Office Managers: Hotel Folio Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office_manager'))]"/>
            <field name="domain_force">['|', ('hotel_reservation_ids', '!=', False), ('hotel_group_master_ids', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_folio_sale_order_line_front_office_manager" model="ir.rule">
            <field name="name">Front Office Managers: Hotel Folio Lines Only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office_manager'))]"/>
            <field name="domain_force">['|', ('order_id.hotel_reservation_ids', '!=', False), ('order_id.hotel_group_master_ids', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_account_payment_front_office" model="ir.rule">
            <field name="name">Front Office: Hotel Payments Only</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">['|', ('hotel_reservation_id', '!=', False), ('folio_id', '!=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_account_payment_system_all" model="ir.rule">
            <field name="name">System: All Payments</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_hotel_account_payment_account_manager_all" model="ir.rule">
            <field name="name">Accounting Managers: All Payments</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_hotel_account_journal_front_office" model="ir.rule">
            <field name="name">Front Office: Cash and Bank Journals Only</field>
            <field name="active" eval="False"/>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">[('active', '=', True), ('type', 'in', ['bank', 'cash'])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_customer_invoice_front_office" model="ir.rule">
            <field name="name">Front Office: Hotel Customer Invoices Only</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">[
                ('move_type', 'in', ['out_invoice', 'out_refund']),
                '|', '|', '|', '|', '|',
                ('hotel_folio_id.hotel_reservation_ids', '!=', False),
                ('hotel_folio_id.hotel_group_master_ids', '!=', False),
                ('invoice_line_ids.hotel_reservation_id', '!=', False),
                ('invoice_line_ids.sale_line_ids.hotel_reservation_id', '!=', False),
                ('invoice_line_ids.sale_line_ids.order_id.hotel_reservation_ids', '!=', False),
                ('invoice_line_ids.sale_line_ids.order_id.hotel_group_master_ids', '!=', False)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_customer_invoice_line_front_office" model="ir.rule">
            <field name="name">Front Office: Hotel Customer Invoice Lines Only</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">[
                ('move_id.move_type', 'in', ['out_invoice', 'out_refund']),
                '|', '|', '|', '|', '|',
                ('move_id.hotel_folio_id.hotel_reservation_ids', '!=', False),
                ('move_id.hotel_folio_id.hotel_group_master_ids', '!=', False),
                ('hotel_reservation_id', '!=', False),
                ('sale_line_ids.hotel_reservation_id', '!=', False),
                ('sale_line_ids.order_id.hotel_reservation_ids', '!=', False),
                ('sale_line_ids.order_id.hotel_group_master_ids', '!=', False)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_reservation_account_receivable_read_all" model="ir.rule">
            <field name="name">Account Receivable: Read Reservations</field>
            <field name="model_id" ref="hotel_management.model_hotel_reservation"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_account_receivable'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_room_housekeeper_all" model="ir.rule">
            <field name="name">Housekeepers: Work Room Operations</field>
            <field name="model_id" ref="hotel_management.model_hotel_room"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_housekeeper'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_hotel_room_front_office_all" model="ir.rule">
            <field name="name">Front Office: Work Room Operations</field>
            <field name="model_id" ref="hotel_management.model_hotel_room"/>
            <field name="groups" eval="[(4, ref('hotel_management.group_hotel_front_office'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
