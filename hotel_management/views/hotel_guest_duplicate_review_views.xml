<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_guest_duplicate_review_wizard_form" model="ir.ui.view">
        <field name="name">hotel.guest.duplicate.review.wizard.form</field>
        <field name="model">hotel.guest.duplicate.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Possible Duplicate Guest Profiles">
                <sheet>
                    <group>
                        <field name="duplicate_count" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        This tool compares possible duplicate contacts for manual review only.
                        It does not merge, delete, or change any guest profile.
                    </p>
                    <field name="duplicate_review_ids" readonly="1">
                        <list>
                            <field name="partner_a_id"/>
                            <field name="partner_b_id"/>
                            <field name="match_reason"/>
                            <field name="confidence_level" widget="badge"
                                   decoration-danger="confidence_level == 'high'"
                                   decoration-warning="confidence_level == 'medium'"
                                   decoration-info="confidence_level == 'low'"/>
                            <field name="passport_display"/>
                            <field name="email_display"/>
                            <field name="phone_display"/>
                            <field name="country_display"/>
                            <field name="nationality_display"/>
                            <button name="action_open_contacts" type="object" string="Open Contacts" icon="fa-external-link"/>
                            <button name="action_mark_reviewed" type="object" string="Mark Reviewed / Ignore" icon="fa-check"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_open_duplicate_guests"
                            type="object"
                            string="Review Possible Duplicates"
                            class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_hotel_guest_duplicate_review_list" model="ir.ui.view">
        <field name="name">hotel.guest.duplicate.review.list</field>
        <field name="model">hotel.guest.duplicate.review</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-danger="confidence_level == 'high'"
                  decoration-warning="confidence_level == 'medium'">
                <field name="partner_a_id"/>
                <field name="partner_b_id"/>
                <field name="match_reason"/>
                <field name="confidence_level" widget="badge"/>
                <field name="passport_display"/>
                <field name="email_display"/>
                <field name="phone_display"/>
                <field name="country_display"/>
                <field name="nationality_display"/>
                <button name="action_open_contacts" type="object" string="Open Contacts" icon="fa-external-link"/>
                <button name="action_mark_reviewed" type="object" string="Mark Reviewed / Ignore" icon="fa-check"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_guest_duplicate_review_form" model="ir.ui.view">
        <field name="name">hotel.guest.duplicate.review.form</field>
        <field name="model">hotel.guest.duplicate.review</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_open_contacts" type="object" string="Open Contacts" class="btn-primary"/>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed / Ignore"
                            class="btn-secondary" invisible="state == 'reviewed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_a_id"/>
                            <field name="partner_b_id"/>
                            <field name="match_reason"/>
                            <field name="confidence_level" widget="badge"/>
                        </group>
                        <group>
                            <field name="passport_display"/>
                            <field name="email_display"/>
                            <field name="phone_display"/>
                            <field name="country_display"/>
                            <field name="nationality_display"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_guest_duplicate_review" model="ir.actions.act_window">
        <field name="name">Review Duplicate Guests</field>
        <field name="res_model">hotel.guest.duplicate.review.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hotel_guest_duplicate_review"
              name="Review Duplicate Guests"
              parent="hotel_management.menu_hotel_config"
              action="action_hotel_guest_duplicate_review"
              sequence="30"
              groups="base.group_system"/>
</odoo>
