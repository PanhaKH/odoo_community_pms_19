<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quick Access List -->
    <record id="view_hotel_quick_access_item_tree" model="ir.ui.view">
        <field name="name">hotel.quick.access.item.tree</field>
        <field name="model">hotel.quick.access.item</field>
        <field name="arch" type="xml">
            <list default_order="sequence asc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="action_type"/>
                <field name="action_id"/>
                <field name="menu_id"/>
                <field name="url"/>
                <field name="icon_type"/>
                <field name="icon_class"/>
                <field name="button_color"/>
                <field name="open_type"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Quick Access Form -->
    <record id="view_hotel_quick_access_item_form" model="ir.ui.view">
        <field name="name">hotel.quick.access.item.form</field>
        <field name="model">hotel.quick.access.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Reservations"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Main Setup">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>

                        <group string="Action Setup">
                            <field name="action_type"/>
                            <field name="action_id" invisible="action_type != 'action'" required="action_type == 'action'"/>
                            <field name="menu_id" invisible="action_type != 'menu'" required="action_type == 'menu'"/>
                            <field name="url" invisible="action_type != 'url'" required="action_type == 'url'"/>
                            <field name="open_type"/>
                        </group>
                    </group>

                    <group>
                        <group string="Icon">
                            <field name="icon_type"/>
                            <field name="icon_class" invisible="icon_type != 'fa'"/>
                            <field name="icon_image" widget="image" invisible="icon_type != 'image'"/>
                        </group>

                        <group string="Button Style">
                            <field name="button_color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quick Access Action -->
    <record id="action_hotel_quick_access_item" model="ir.actions.act_window">
        <field name="name">Quick Access Toolbar</field>
        <field name="res_model">hotel.quick.access.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    
    <!-- Add Quick Access Toolbar to Hotel Dashboard -->
    <record id="view_hotel_dashboard_form_quick_access" model="ir.ui.view">
        <field name="name">hotel.dashboard.form.quick.access</field>
        <field name="model">hotel.dashboard</field>
        <field name="inherit_id" ref="hotel_management.view_hotel_dashboard_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/*[1]" position="before">

                <!-- Compact Quick Access Toolbar beside dashboard top buttons -->
                <div class="hotel_quick_access_line">

                    <field name="quick_access_item_ids"
                        nolabel="1"
                        readonly="1"
                        mode="kanban">
                        <kanban create="false" delete="false" class="hotel_quick_access_strip">
                            <field name="name"/>
                            <field name="icon_type"/>
                            <field name="icon_class"/>
                            <field name="icon_image"/>
                            <field name="button_css_class"/>

                            <templates>
                                <t t-name="card">
                                    <button type="object"
                                            name="action_open"
                                            t-attf-class="btn btn-sm #{record.button_css_class.raw_value} shadow-sm hotel_qa_btn">
                                        <t t-if="record.icon_type.raw_value == 'image' and record.icon_image.raw_value">
                                            <img t-att-src="'/web/image/hotel.quick.access.item/' + record.id.raw_value + '/icon_image'"
                                                style="width:16px;height:16px;object-fit:contain;margin-right:4px;"/>
                                        </t>
                                        <t t-elif="record.icon_class.raw_value">
                                            <i t-attf-class="fa #{record.icon_class.raw_value} me-1"/>
                                        </t>
                                        <field name="name"/>
                                    </button>
                                </t>
                            </templates>
                        </kanban>
                    </field>

                    <button name="action_open_quick_access_setup"
                            type="object"
                            string="Setup"
                            class="btn btn-sm btn-outline-secondary hotel_qa_setup_btn"
                            groups="hotel_management.group_hotel_manager,hotel_management.group_hotel_system_admin,base.group_system"/>

                </div>

            </xpath>

        </field>
    </record>

</odoo>