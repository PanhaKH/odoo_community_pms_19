<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_service_request_tree" model="ir.ui.view">
        <field name="name">hotel.service.request.tree</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'new'" decoration-success="state == 'done'" decoration-warning="state == 'progress'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="room_id"/>
                <field name="request_type"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
                <button name="action_done" string="Done" type="object" icon="fa-check" invisible="state != 'progress'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_service_request_form" model="ir.ui.view">
        <field name="name">hotel.service.request.form</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_progress" string="In Progress" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" string="Completed" type="object" class="btn-success" invisible="state != 'progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="room_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="request_type"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_service_request" model="ir.actions.act_window">
        <field name="name">Guest Requests</field>
        <field name="res_model">hotel.service.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
