<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_service_request_tree" model="ir.ui.view">
        <field name="name">hotel.service.request.tree</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'new'" decoration-success="state == 'done'" decoration-warning="state == 'progress'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="room_id"/>
                <field name="request_type"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
                <button name="action_done" string="Done" type="object" icon="fa-check" invisible="state != 'progress'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_service_request_form" model="ir.ui.view">
        <field name="name">hotel.service.request.form</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_progress" string="In Progress" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" string="Completed" type="object" class="btn-success" invisible="state != 'progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['done', 'cancel']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="room_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="request_type"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_service_request_feature_tree" model="ir.ui.view">
        <field name="name">hotel.service.request.feature.list</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" duplicate="false"
                  decoration-info="state == 'new'"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'progress'">
                <header>
                    <button name="%(action_hotel_guest_request_submit_wizard)d"
                            type="action"
                            string="Submit Guest Request"
                            class="btn-primary"
                            groups="hotel_management.hotel_feature_guest_request_submit"/>
                </header>
                <field name="name"/>
                <field name="create_date"/>
                <field name="feature_room_display"/>
                <field name="request_type"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_service_request_feature_form" model="ir.ui.view">
        <field name="name">hotel.service.request.feature.form</field>
        <field name="model">hotel.service.request</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" duplicate="false">
                <header>
                    <button name="%(action_hotel_guest_request_submit_wizard)d"
                            type="action"
                            string="Submit Guest Request"
                            class="btn-primary"
                            groups="hotel_management.hotel_feature_guest_request_submit"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="feature_room_display" readonly="1"/>
                            <field name="request_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_service_request_feature" model="ir.actions.act_window">
        <field name="name">Guest Requests</field>
        <field name="res_model">hotel.service.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hotel_service_request_feature_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hotel_service_request_feature_form')})]"/>
    </record>

    <record id="action_hotel_service_request" model="ir.actions.act_window">
        <field name="name">Guest Requests</field>
        <field name="res_model">hotel.service.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
