<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_noshow_wizard_form" model="ir.ui.view">
        <field name="name">hotel.noshow.wizard.form</field>
        <field name="model">hotel.noshow.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark as No-Show">
                <group>
                    <field name="reason" placeholder="e.g. Guest did not arrive, phone unreachable..."/>
                </group>
                <footer>
                    <button name="action_confirm_noshow" string="Confirm No-Show" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>