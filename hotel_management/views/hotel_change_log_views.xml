<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hotel_change_log_tree" model="ir.ui.view">
        <field name="name">hotel.change.log.tree</field>
        <field name="model">hotel.change.log</field>
        <field name="arch" type="xml">
            <list string="Exchange Journal" create="0" edit="0" delete="0">
                <field name="change_date"/>
                <field name="reservation_id" widget="many2one_clickable"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="change_type"/>
                <field name="field_name" decoration-bf="1"/>
                <field name="old_value" decoration-danger="1"/>
                <field name="new_value" decoration-success="1"/>
                <field name="reason" optional="show"/>
                <field name="source_document_ref" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_change_log_form" model="ir.ui.view">
        <field name="name">hotel.change.log.form</field>
        <field name="model">hotel.change.log</field>
        <field name="arch" type="xml">
            <form string="Exchange Journal" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="reservation_id" readonly="1"/>
                            <field name="change_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="change_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="field_name" readonly="1"/>
                            <field name="reason" readonly="1"/>
                            <field name="source_document_ref" readonly="1"/>
                            <field name="source_document_name" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="old_value" readonly="1"/>
                        </group>
                        <group>
                            <field name="new_value" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_change_log_search" model="ir.ui.view">
        <field name="name">hotel.change.log.search</field>
        <field name="model">hotel.change.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="reservation_id"/>
                <field name="user_id"/>
                <field name="field_name"/>
                <field name="source_document_ref"/>
                <group>
                    <filter string="User" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'change_date:day'}"/>
                    <filter string="Reservation" name="group_res" context="{'group_by':'reservation_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'change_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_change_log" model="ir.actions.act_window">
        <field name="name">Exchange Journal</field>
        <field name="res_model">hotel.change.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- <menuitem id="menu_hotel_change_journal" 
              name="Change Journal" 
              parent="menu_hotel_root" 
              action="action_hotel_change_log" 
              sequence="50"/> -->

</odoo>

