<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_lost_found_tree" model="ir.ui.view">
        <field name="name">hotel.lost.found.tree</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'found'" decoration-success="state == 'returned'" decoration-muted="state == 'disposed'">
                <field name="date_found"/>
                <field name="name"/>
                <field name="category"/>
                <field name="location_found"/>
                <field name="room_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" decoration-info="state == 'found'" decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_lost_found_form" model="ir.ui.view">
        <field name="name">hotel.lost.found.form</field>
        <field name="model">hotel.lost.found</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_claim" string="Mark as Claimed" type="object" class="btn-primary" invisible="state != 'found'"/>
                    <button name="action_return" string="Register Return" type="object" class="btn-success" invisible="state not in ['found', 'claimed']"/>
                    <button name="action_dispose" string="Dispose / Donate" type="object" class="btn-secondary" invisible="state != 'found'" confirm="Are you sure you want to dispose of this item?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. iPhone Charger"/></h1>
                    </div>
                    <group>
                        <group string="Found Details">
                            <field name="date_found"/>
                            <field name="finder_id"/>
                            <field name="location_found"/>
                            <field name="room_id" invisible="location_found != 'room'"/>
                            <field name="category"/>
                        </group>
                        <group string="Guest Information">
                            <field name="partner_id"/>
                            <field name="reservation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the item condition, color, brand..."/>
                        </page>
                        <page string="Return Details" invisible="state != 'returned'">
                            <group>
                                <field name="return_date" readonly="1"/>
                                <field name="return_details"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_lost_found" model="ir.actions.act_window">
        <field name="name">Lost &amp; Found</field>
        <field name="res_model">hotel.lost.found</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a new Lost Item
            </p>
        </field>
    </record>
</odoo>
