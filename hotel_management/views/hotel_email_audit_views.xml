<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_email_audit_list" model="ir.ui.view">
        <field name="name">hotel.email.audit.list</field>
        <field name="model">hotel.email.audit</field>
        <field name="arch" type="xml">
            <list string="Email Communication">
                <field name="create_date" string="Date"/>
                <field name="audit_type" string="Type"/>
                <field name="recipient"/>
                <field name="status" widget="badge"/>
                <field name="subject"/>
                <field name="failure_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_email_audit_form" model="ir.ui.view">
        <field name="name">hotel.email.audit.form</field>
        <field name="model">hotel.email.audit</field>
        <field name="arch" type="xml">
            <form string="Email Audit">
                <sheet>
                    <group>
                        <field name="reservation_id"/>
                        <field name="audit_type"/>
                        <field name="recipient"/>
                        <field name="status"/>
                        <field name="subject"/>
                        <field name="mail_id"/>
                        <field name="attachment_id"/>
                        <field name="failure_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
