<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_floor_plan_kanban" model="ir.ui.view">
        <field name="name">hotel.room.floor.plan.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban create="false" default_group_by="floor_id" class="o_hotel_floor_plan">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="state"/>
                <field name="floor_plan_color"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-0 mb-1 shadow-sm" style="height: 75px; width: 130px; overflow: hidden; border: 1px solid rgba(0,0,0,0.2); border-radius: 4px;">
                            
                            <div t-attf-style="background-color: #{record.floor_plan_color.raw_value} !important; height: 100%; width: 100%; padding: 6px; display: flex; flex-direction: column; justify-content: space-between;">
                                
                                <div class="d-flex justify-content-between align-items-start text-dark fw-bold">
                                    <span style="font-size: 14px;"><field name="name"/></span>
                                    <span style="font-size: 10px; opacity: 0.8;" class="text-truncate ms-1"><field name="room_type_id"/></span>
                                </div>

                                <div class="text-center fw-bolder text-uppercase mt-auto text-dark" style="font-size: 11px; line-height: 1.1;">
                                    <field name="state"/>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hotel_floor_plan_kanban" model="ir.actions.act_window">
        <field name="name">Floor Plan</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_hotel_floor_plan_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rooms found! Check your configuration.
            </p>
        </field>
    </record>
</odoo>
